# ============================================
# AI Firewall — Environment Variables Template
# ============================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored).
#
# Usage:  cp .env.example .env
# ============================================

# --- LLM Backend API Keys ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Local Llama (W7) ---
# URL of the local Ollama server
LLAMA_BASE_URL=http://localhost:11434

# --- Gateway settings ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_API_KEY=replace-with-random-string-for-our-clients

# --- Redis (W5, W7) ---
REDIS_URL=redis://localhost:6379/0

# --- Detection thresholds ---
# Above this XGBoost score → block at L1a (very confident only)
L1_BLOCK_THRESHOLD=0.95
# Below this XGBoost score → pass without further checks
L1_PASS_THRESHOLD=0.2
# If L1a >= this AND L1b says "pass" → escalate to L2 (catches L1a/L1b disagreement).
# Lowered to 0.5 in W6 after the OWASP harness found a persona-flip attack
# slipping through at L1a≈0.5; L2 escalation closes the gap.
L1_DISAGREEMENT_THRESHOLD=0.5

# --- Rate limiting (W7) ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
